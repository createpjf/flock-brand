{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "brand": {
      "blue":      { "$value": "#3773FF", "$description": "PDF-canonical hero color. Dominant brand identifier." }
    },
    "neutral": {
      "black":     { "$value": "#000000", "$description": "PDF-canonical primary dark background and text on light." },
      "off-white": { "$value": "#F2F2F2", "$description": "PDF-canonical light background. Replaces pure white." },
      "white":     { "$value": "#FFFFFF" }
    },
    "secondary": {
      "orange":    { "$value": "#FF8B00", "$description": "Accent only — highlights, notifications." },
      "turquoise": { "$value": "#03BFD4", "$description": "Accent only — data viz." },
      "purple":    { "$value": "#9C59F3", "$description": "Accent only — premium features." }
    },
    "extended": {
      "green":     { "$value": "#22B473", "$description": "Internal extension — success states. NOT in official PDF." },
      "border":    { "$value": "#E0E4F0", "$description": "Internal — 1px border on white cards." },
      "surface":   { "$value": "#F8F8F8", "$description": "Internal — softer page when cards sit on Off White." }
    },
    "tint": {
      "blue":      { "$value": "#98B8F8" },
      "teal":      { "$value": "#B8E8F0" },
      "purple":    { "$value": "#D0B8F8" },
      "orange":    { "$value": "#F8D0A8" }
    },
    "semantic": {
      "bg-dark":       { "$value": "{color.neutral.black}" },
      "bg-light":      { "$value": "{color.neutral.off-white}" },
      "bg-brand":      { "$value": "{color.brand.blue}" },
      "text-on-dark":  { "$value": "{color.neutral.white}" },
      "text-on-light": { "$value": "{color.neutral.black}" },
      "text-on-brand": { "$value": "{color.neutral.white}" },
      "heading-on-light": { "$value": "{color.brand.blue}" }
    }
  },
  "font": {
    "family": {
      "primary": {
        "$value": "'TWK Everett', 'Inter', 'SF Pro Display', 'Alibaba PuHuiTi 3.0', 'PingFang SC', 'Hiragino Sans GB', 'Noto Sans SC', 'Source Han Sans SC', 'Microsoft YaHei', 'Helvetica Neue', 'Arial', sans-serif"
      },
      "mono": {
        "$value": "'SF Mono', 'JetBrains Mono', 'Fira Code', 'Consolas', monospace"
      }
    },
    "size": {
      "h1":      { "$value": "64px" },
      "h2":      { "$value": "48px" },
      "h3":      { "$value": "36px" },
      "body":    { "$value": "24px" },
      "caption": { "$value": "14px" },
      "data":    { "$value": "12px" }
    },
    "weight": {
      "regular":  { "$value": 400 },
      "medium":   { "$value": 500 },
      "bold":     { "$value": 700 }
    },
    "lineHeight": {
      "tight":   { "$value": 1.0 },
      "normal":  { "$value": 1.2 },
      "relaxed": { "$value": 1.4 }
    },
    "tracking": {
      "tight":   { "$value": "-0.04em" },
      "normal":  { "$value": "-0.03em" },
      "cjk":     { "$value": "-0.01em" }
    }
  },
  "spacing": {
    "xs":  { "$value": "4px" },
    "sm":  { "$value": "8px" },
    "md":  { "$value": "16px" },
    "lg":  { "$value": "24px" },
    "xl":  { "$value": "32px" },
    "2xl": { "$value": "48px" },
    "3xl": { "$value": "64px" }
  },
  "radius": {
    "sm": { "$value": "4px" },
    "md": { "$value": "8px" },
    "lg": { "$value": "12px" },
    "xl": { "$value": "16px" }
  },
  "grid": {
    "color":   { "$value": "#E0E4F0" },
    "opacity": { "$value": 0.06 },
    "size":    { "$value": "40px" }
  }
}
